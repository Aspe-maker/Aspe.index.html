</div>

<script>
const DATA = {
  math: {
    name: "الرياضيات",
    icon: "∑",
    className: "math",
    sections: [
      { title: "أولى ثانوي", lessons: ["التبرير والبرهان","المسلمات والعلاقات الهندسية","المستقيم","المثلث","المضلعات والأشكال الرباعية","التشابه","التحويلات الهندسية","الدائرة"] },
      { title: "ثاني ثانوي", lessons: ["الأعداد الحقيقية والدوال","دوال خاصة","المتباينات","المصفوفات","الأعداد المركبة والمعادلة التربيعية","كثيرات الحدود","العمليات على الدوال"] },
      { title: "ثالث ثانوي", lessons: ["الدالة الجذرية","العلاقات والدوال النسبية","المتتابعات والمتسلسلات","نظرية ذات الحدين","الاحتمالات","حساب المثلثات"] }
    ]
  },
  bio: {
    name: "الأحياء",
    icon: "❁",
    className: "bio",
    sections: [
      { title: "أحياء 1", lessons: ["دراسة الحياة","تنظيم تنوع الحياة","البكتيريا والفيروسات","الطلائعيات","الفطريات","صور تلخيصية للحيوانات","مدخل إلى الحيوانات","الديدان والرخويات","المفصليات"] },
      { title: "أحياء 2", lessons: ["شوكيات الجلد واللافقاريات الحبلية","طائفة الأسماك","طائفة البرمائيات","طائفة الزواحف","طائفة الطيور","طائفة الثدييات","النباتات اللاوعائية","النباتات الوعائية اللابذرية","النباتات الوعائية البذرية","الخلايا والأنسجة النباتية","الهرمونات واستجابة النباتات","النباتات الزهرية وتكاثرها"] },
      { title: "أحياء 3", lessons: ["الجهاز الهيكلي","الجهاز العضلي","الجهاز العصبي","تنظيم الجهاز العصبي","الجهاز الدوراني","الجهازان التنفسي والاخراجي","الجهاز الهضمي","التغذية","جهاز الغدد الصم","جهاز التكاثر في الإنسان","مراحل نمو الجنين","جهاز المناعة"] },
      { title: "أحياء 4", lessons: ["التراكيب الخلوية والعضيات","كيمياء الخلية","الطاقة الخلوية","البناء الضوئي والتنفس الخلوي","التكاثر الخلوي","الانقسام المنصف","الوراثة المندلية","ملخص الوراثة المندلية","الوراثة المعقدة والبشرية","المادة الوراثية"] },
      { title: "علم البيئة", lessons: ["المخلوقات الحية وعلاقاتها المتبادلة","انتقال الطاقة في النظام البيئي","تدوير المواد","المجتمعات والمناطق الحيوية","الأنظمة البيئية المائية","علم بيئة الجماعات الحيوية","التنوع الحيوي والمحافظة عليه","سلوك الحيوان"] }
    ]
  },
  phys: {
    name: "الفيزياء",
    icon: "⚡",
    className: "phys",
    sections: [
      { title: "أولى ثانوي", lessons: ["مدخل إلى علم الفيزياء","الإزاحة والسرعة والتسارع","التسارع والسقوط الحر","القوى والوزن وقوانين نيوتن","المتجهات والاحتكاك والحركة المائلة","المقذوف والحركة الدائرية"] },
      { title: "ثاني ثانوي", lessons: ["الجاذبية","الحركة الدورانية","الاتزان والدفع والزخم","الشغل والطاقة","القدرة والآلات","الحرارة","تغيرات الحالة والديناميكا الحرارية"] },
      { title: "ثالث ثانوي", lessons: [] }
    ]
  },
  chem: {
    name: "الكيمياء",
    icon: "⚗",
    className: "chem",
    sections: [
      { title: "كيمياء 1 - أولى ثانوي", lessons: ["مقدمة في علم الكيمياء","الخواص والتغيرات والمخاليط","تركيب الذرة","العنصر والمركب والتفاعلات الكيميائية","الحسابات الكيميائية"] },
      { title: "كيمياء 2 - ثاني ثانوي", lessons: ["الضوء والكم والذرة ومستوياتها","التوزيع الالكتروني","الجدول الدوري الحديث","تصنيف العناصر وتدرج خواصها","ملخص الجدول الدوري","الروابط والمركبات الأيونية","الرابطة الفلزية والتساهمية","تراكيب لويس وأشكال الجزيئات","الكهروسالبية والقوى بين الجزيئات"] },
      { title: "كيمياء 3", lessons: ["المادة الغازية","المواد السائلة والصلبة","الكيمياء الحرارية","تغيرات الحالة والطاقة والحرارة","سرعة التفاعلات الكيميائية","الاتزان الكيميائي"] },
      { title: "كيمياء 4", lessons: ["الهيدروكربونات","متشكلات الهيدروكربونات","مشتقات الهيدروكربونات","تفاعلات المشتقات","البوليمرات","الكيمياء الحيوية","قوانين وحسابات الغازات"] }
    ]
  }
};

let completed = new Set();
let storageReady = false;

async function loadProgress(){
  try{
    const res = await window.storage.get('completed-lessons', false);
    if(res && res.value){
      const arr = JSON.parse(res.value);
      completed = new Set(arr);
    }
  }catch(e){
    completed = new Set();
  }
  storageReady = true;
  renderHome();
}

async function saveProgress(){
  try{
    await window.storage.set('completed-lessons', JSON.stringify(Array.from(completed)), false);
  }catch(e){
    console.error('تعذر حفظ التقدم', e);
  }
}

function lessonKey(subjectId, sectionIdx, lessonIdx){
  return subjectId + ':' + sectionIdx + ':' + lessonIdx;
}

function subjectTotals(subjectId){
  const subj = DATA[subjectId];
  let total = 0, done = 0;
  subj.sections.forEach((sec, si)=>{
    sec.lessons.forEach((_, li)=>{
      total++;
      if(completed.has(lessonKey(subjectId, si, li))) done++;
    });
  });
  return {total, done};
}

function overallTotals(){
  let total = 0, done = 0;
  Object.keys(DATA).forEach(id=>{
    const t = subjectTotals(id);
    total += t.total; done += t.done;
  });
  return {total, done};
}

function updateOverallCard(){
  const {total, done} = overallTotals();
  const pct = total ? Math.round((done/total)*100) : 0;
  const circumference = 201;
  const offset = circumference - (pct/100)*circumference;
  document.getElementById('overall-ring').style.strokeDashoffset = offset;
  document.getElementById('overall-percent').textContent = pct + '%';
  document.getElementById('overall-count').textContent = done + ' من ' + total + ' درسًا';
}

function renderHome(){
  updateOverallCard();
  const home = document.getElementById('home-view');
  home.innerHTML = '';
  Object.keys(DATA).forEach(id=>{
    const subj = DATA[id];
    const {total, done} = subjectTotals(id);
    const pct = total ? Math.round((done/total)*100) : 0;
    const card = document.createElement('div');
    card.className = 'subject-card ' + subj.className;
    card.innerHTML = `
      <div class="icon">${subj.icon}</div>
      <div class="name">${subj.name}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
      <div class="meta">${done} من ${total} درسًا · ${pct}%</div>
    `;
    card.addEventListener('click', ()=>openSubject(id));
    home.appendChild(card);
  });
  document.getElementById('home-view').style.display = 'grid';
  document.getElementById('subject-view').style.display = 'none';
  document.getElementById('home-header').style.display = 'block';
}

function openSubject(id){
  const subj = DATA[id];
  const view = document.getElementById('subject-view');
  const {total, done} = subjectTotals(id);
  const pct = total ? Math.round((done/total)*100) : 0;

  let html = `
    <button class="back-btn" id="back-btn">→ &nbsp;العودة إلى المواد</button>
    <div class="subject-header">
      <div class="icon-lg ${subj.className}" style="background:var(--${cssVarBase(subj.className)}-soft);color:var(--${cssVarBase(subj.className)});">${subj.icon}</div>
      <div>
        <div class="title">${subj.name}</div>
        <div class="sub-progress">${done} من ${total} درسًا مكتملة · ${pct}%</div>
      </div>
    </div>
    <div class="subject-bar-track"><div class="subject-bar-fill" id="subject-bar" style="width:${pct}%;background:var(--${cssVarBase(subj.className)})"></div></div>
  `;

  subj.sections.forEach((sec, si)=>{
    html += `<div class="section-block">
      <div class="section-title"><span>${sec.title}</span><span class="count" id="sec-count-${si}"></span></div>`;
    if(sec.lessons.length === 0){
      html += `<div class="empty-note">لا توجد دروس مضافة بعد لهذا المستوى</div>`;
    } else {
      sec.lessons.forEach((lesson, li)=>{
        const key = lessonKey(id, si, li);
        const isDone = completed.has(key);
        html += `
          <div class="lesson-row ${subj.className}-row ${isDone ? 'done':''}" data-subject="${id}" data-section="${si}" data-lesson="${li}">
            <div class="checkbox">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div class="lesson-name">${lesson}</div>
          </div>`;
      });
    }
    html += `</div>`;
  });

  view.innerHTML = html;
  view.style.display = 'block';
  document.getElementById('home-view').style.display = 'none';
  document.getElementById('home-header').style.display = 'none';

  document.getElementById('back-btn').addEventListener('click', renderHome);

  view.querySelectorAll('.lesson-row').forEach(row=>{
    row.addEventListener('click', ()=>{
      const subjectId = row.dataset.subject;
      const si = row.dataset.section;
      const li = row.dataset.lesson;
      const key = lessonKey(subjectId, si, li);
      if(completed.has(key)) completed.delete(key);
      else completed.add(key);
      row.classList.toggle('done');
      updateSubjectProgress(subjectId);
      updateOverallCard();
      saveProgress();
    });
  });

  updateSectionCounts(id);
}

function cssVarBase(className){
  return className;
}

function updateSubjectProgress(id){
  const subj = DATA[id];
  const {total, done} = subjectTotals(id);
  const pct = total ? Math.round((done/total)*100) : 0;
  const bar = document.getElementById('subject-bar');
  if(bar) bar.style.width = pct + '%';
  const subProgressEl = document.querySelector('.sub-progress');
  if(subProgressEl) subProgressEl.textContent = `${done} من ${total} درسًا مكتملة · ${pct}%`;
  updateSectionCounts(id);
}

function updateSectionCounts(id){
  const subj = DATA[id];
  subj.sections.forEach((sec, si)=>{
    const total = sec.lessons.length;
    let done = 0;
    sec.lessons.forEach((_, li)=>{ if(completed.has(lessonKey(id, si, li))) done++; });
    const el = document.getElementById('sec-count-'+si);
    if(el) el.textContent = total ? `${done} / ${total}` : '';
  });
}

loadProgress();
</script>
</body>
</html>
