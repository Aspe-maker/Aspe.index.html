<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Study World - عالم المذاكرة ثلاثي الأبعاد</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            user-select: none;
            background-color: #111;
        }

        #canvas-container {
            width: 100vw;
            height: 100vh;
            display: block;
        }

        /* واجهة التعليمات وعلامة التصويب */
        #crosshair {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 10px;
            height: 10px;
            border: 2px solid rgba(255, 255, 255, 0.7);
            border-radius: 50%;
            pointer-events: none;
            z-index: 10;
        }

        #instructions {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(0, 0, 0, 0.75);
            color: #fff;
            padding: 15px;
            border-radius: 8px;
            pointer-events: none;
            z-index: 10;
            font-size: 14px;
            line-height: 1.6;
        }

        /* شريط الـ Hotbar السفلي */
        #hotbar {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            background: rgba(0, 0, 0, 0.8);
            padding: 10px;
            border-radius: 12px;
            z-index: 10;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .hotbar-slot {
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 24px;
            cursor: pointer;
            transition: 0.2s;
        }

        .hotbar-slot.active {
            border-color: #4CAF50;
            background: rgba(76, 175, 80, 0.3);
            transform: scale(1.05);
        }

        /* قائمة العناصر الإضافية (Item Menu) */
        #item-menu {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(20, 20, 20, 0.95);
            border: 2px solid #444;
            border-radius: 12px;
            padding: 20px;
            width: 400px;
            max-height: 80vh;
            overflow-y: auto;
            display: none;
            z-index: 20;
            color: white;
        }

        #item-menu h2 {
            margin-top: 0;
            text-align: center;
            font-size: 20px;
            border-bottom: 1px solid #444;
            padding-bottom: 10px;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .menu-item {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #555;
            border-radius: 8px;
            padding: 10px;
            text-align: center;
            cursor: pointer;
            transition: 0.2s;
        }

        .menu-item:hover {
            background: rgba(76, 175, 80, 0.2);
            border-color: #4CAF50;
        }

        .menu-item span {
            font-size: 28px;
            display: block;
            margin-bottom: 5px;
        }

        .menu-item label {
            font-size: 12px;
            display: block;
            color: #ccc;
            cursor: pointer;
        }

        /* نافذة كتابة النصوص والسبورة */
        #text-modal {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(20, 20, 20, 0.95);
            border: 2px solid #444;
            border-radius: 12px;
            padding: 20px;
            width: 300px;
            display: none;
            z-index: 30;
            color: white;
            text-align: center;
        }

        #text-modal input {
            width: 90%;
            padding: 10px;
            margin-top: 10px;
            margin-bottom: 15px;
            background: #333;
            border: 1px solid #555;
            color: white;
            border-radius: 6px;
            font-size: 16px;
            text-align: center;
        }

        #text-modal button {
            background: #4CAF50;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        #text-modal button:hover {
            background: #45a049;
        }
    </style>
</head>
<body>

    <div id="crosshair"></div>
    
    <div id="instructions">
        <h3>Study World - التعليمات</h3>
        <b>W A S D</b>: الحركة<br>
        <b>المؤشر (Mouse)</b>: النظر والتوجيه<br>
        <b>Click Left</b>: وضع العنصر الحالي<br>
        <b>R</b>: تدوير العنصر المختار<br>
        <b>Delete</b>: حذف العنصر الموجه إليه<br>
        <b>E</b>: فتح قائمة العناصر الكاملة<br>
        <b>Esc</b>: إغلاق القوائم وتحرير الماوس
    </div>

    <div id="hotbar">
        <div class="hotbar-slot active" data-id="bulb">💡</div>
        <div class="hotbar-slot" data-id="lightning">⚡</div>
        <div class="hotbar-slot" data-id="car">🚗</div>
        <div class="hotbar-slot" data-id="magnet">🧲</div>
        <div class="hotbar-slot" data-id="dna">🧬</div>
        <div class="hotbar-slot" data-id="flask">🧪</div>
        <div class="hotbar-slot" data-id="board">📝</div>
        <div class="hotbar-slot" data-id="text">💬</div>
    </div>

    <div id="item-menu">
        <h2>قائمة العناصر (Creative Mode)</h2>
        <div class="menu-grid" id="menu-grid"></div>
    </div>

    <div id="text-modal">
        <h3>اكتب محتوى السبورة / النص</h3>
        <input type="text" id="text-input" placeholder="اكتب هنا...">
        <br>
        <button id="save-text-btn">تأكيد</button>
    </div>

    <div id="canvas-container"></div>

    <!-- استدعاء مكتبة Three.js ومكتبة التحكم -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/PointerLockControls.js"></script>

    <script>
        // تعريف قائمة العناصر المتاحة
        const availableItems = {
            bulb: { name: 'لمبة', icon: '💡', type: 'model', color: 0xfffaa0 },
            lightning: { name: 'برق', icon: '⚡', type: 'model', color: 0x00ffff },
            car: { name: 'سيارة', icon: '🚗', type: 'model', color: 0xff3333 },
            magnet: { name: 'مغناطيس', icon: '🧲', type: 'model', color: 0x3333ff },
            dna: { name: 'DNA', icon: '🧬', type: 'model', color: 0x33ff33 },
            flask: { name: 'دورق', icon: '🧪', type: 'model', color: 0xff66cc },
            board: { name: 'سبورة', icon: '📝', type: 'board', color: 0x224422 },
            text: { name: 'نص ثلاثي الأبعاد', icon: '💬', type: 'text', color: 0xffffff },
            math_shape: { name: 'شكل هندسي', icon: '📐', type: 'model', color: 0xff9900 },
            clock: { name: 'ساعة', icon: '⏰', type: 'model', color: 0xaaaaaa }
        };

        let currentSelectedItem = 'bulb';
        let scene, camera, renderer, controls;
        let objectsInWorld = [];
        let moveForward = false, moveBackward = false, moveLeft = false, moveRight = false;
        let prevTime = performance.now();
        let velocity = new THREE.Vector3();
        let direction = new THREE.Vector3();
        
        let isMenuOpen = false;
        let isTextModalOpen = false;
        let pendingTextPosition = null;

        init();
        animate();

        function init() {
            // إعداد المشهد الأساسي
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x1a1a1a);
            scene.fog = new THREE.FogExp2(0x1a1a1a, 0.015);

            // إعداد الكاميرا
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 2, 10);

            // إعداد المرتسم (Renderer)
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            document.getElementById('canvas-container').appendChild(renderer.domElement);

            // إعداد التحكم (PointerLockControls)
            controls = new THREE.PointerLockControls(camera, document.body);
            
            document.addEventListener('click', () => {
                if (!isMenuOpen && !isTextModalOpen) {
                    controls.lock();
                }
            });

            // الإضاءة
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
            dirLight.position.set(20, 40, 20);
            dirLight.castShadow = true;
            scene.add(dirLight);

            // إنشاء البيئة والشقق الأربع
            createEnvironment();

            // ملء قائمة الـ Items في واجهة Creative Mode
            populateItemMenu();

            // الأحداث وحركة الكيبورد
            window.addEventListener('resize', onWindowResize);
            document.addEventListener('keydown', onKeyDown);
            document.addEventListener('keyup', onKeyUp);
            document.addEventListener('mousedown', onMouseDown);

            // ربط أزرار الـ Hotbar
            document.querySelectorAll('.hotbar-slot').forEach(slot => {
                slot.addEventListener('click', (e) => {
                    e.stopPropagation();
                    document.querySelectorAll('.hotbar-slot').forEach(s => s.classList.remove('active'));
                    slot.classList.add('active');
                    currentSelectedItem = slot.getAttribute('data-id');
                });
            });

            // تحميل العالم المحفوظ سابقاً
            loadWorld();
        }

        function createEnvironment() {
            // الأرضية العامة
            const floorGeo = new THREE.PlaneGeometry(100, 100);
            const floorMat = new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.8 });
            const floor = new THREE.Mesh(floorGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            floor.receiveShadow = true;
            scene.add(floor);

            // تصميم الشقق الأربع (الرياضيات، الأحياء، الكيمياء، الفيزياء)
            const apartments = [
                { name: 'الرياضيات', color: 0x1e3d59, x: -15, z: -15 },
                { name: 'الأحياء', color: 0x17b978, x: 15, z: -15 },
                { name: 'الكيمياء', color: 0xff6e40, x: -15, z: 15 },
                { name: 'الفيزياء', color: 0xffc107, x: 15, z: 15 }
            ];

            apartments.forEach(apt => {
                const group = new THREE.Group();

                // أرضية الشقة
                const aptFloor = new THREE.Mesh(
                    new THREE.BoxGeometry(12, 0.2, 12),
                    new THREE.MeshStandardMaterial({ color: apt.color, roughness: 0.5 })
                );
                aptFloor.position.set(apt.x, 0.1, apt.z);
                aptFloor.receiveShadow = true;
                scene.add(aptFloor);

                // جدران الشقة الخلفية والجانبية
                const wallMat = new THREE.MeshStandardMaterial({ color: 0x333333, roughness: 0.9 });
                
                const wall1 = new THREE.Mesh(new THREE.BoxGeometry(12, 4, 0.5), wallMat);
                wall1.position.set(apt.x, 2, apt.z - 6);
                scene.add(wall1);

                const wall2 = new THREE.Mesh(new THREE.BoxGeometry(0.5, 4, 12), wallMat);
                wall2.position.set(apt.x - 6, 2, apt.z);
                scene.add(wall2);

                // طاولة مركزية في كل شقة كمبدأ أثاث أساسي
                const tableTop = new THREE.Mesh(
                    new THREE.BoxGeometry(4, 0.2, 2),
                    new THREE.MeshStandardMaterial({ color: 0x5c4033 })
                );
                tableTop.position.set(apt.x, 1, apt.z);
                tableTop.castShadow = true;
                tableTop.receiveShadow = true;
                scene.add(tableTop);

                // أرجل الطاولة
                for(let dx of [-1.8, 1.8]) {
                    for(let dz of [-0.8, 0.8]) {
                        const leg = new THREE.Mesh(
                            new THREE.CylinderGeometry(0.1, 0.1, 1),
                            new THREE.MeshStandardMaterial({ color: 0x111111 })
                        );
                        leg.position.set(apt.x + dx, 0.5, apt.z + dz);
                        scene.add(leg);
                    }
                }
            });
        }

        function populateItemMenu() {
            const grid = document.getElementById('menu-grid');
            grid.innerHTML = '';
            for (let key in availableItems) {
                const item = availableItems[key];
                const div = document.createElement('div');
                div.className = 'menu-item';
                div.innerHTML = `<span>${item.icon}</span><label>${item.name}</label>`;
                div.onclick = () => {
                    currentSelectedItem = key;
                    toggleItemMenu();
                };
                grid.appendChild(div);
            }
        }

        function toggleItemMenu() {
            isMenuOpen = !isMenuOpen;
            const menu = document.getElementById('item-menu');
            if (isMenuOpen) {
                menu.style.display = 'block';
                controls.unlock();
            } else {
                menu.style.display = 'none';
            }
        }

        function onKeyDown(event) {
            switch (event.code) {
                case 'KeyW': moveForward = true; break;
                case 'KeyS': moveBackward = true; break;
                case 'KeyA': moveLeft = true; break;
                case 'KeyD': moveRight = true; break;
                case 'KeyE': toggleItemMenu(); break;
                case 'KeyR': rotateSelectedObject(); break;
                case 'Delete': removeAimedObject(); break;
                case 'Escape': 
                    if (isMenuOpen) toggleItemMenu();
                    if (isTextModalOpen) closeTextModal();
                    break;
            }
        }

        function onKeyUp(event) {
            switch (event.code) {
                case 'KeyW': moveForward = false; break;
                case 'KeyS': moveBackward = false; break;
                case 'KeyA': moveLeft = false; break;
                case 'KeyD': moveRight = false; break;
            }
        }

        function onMouseDown(event) {
            if (event.button === 0 && controls.isLocked) { // Left Click للوضع
                placeItem();
            }
        }

        function placeItem() {
            const itemData = availableItems[currentSelectedItem];
            if (!itemData) return;

            // تحديد مكان الوضع أمام الكاميرا مباشرة
            const distance = 3;
            const position = new THREE.Vector3();
            camera.getWorldPosition(position);
            const direction = new THREE.Vector3();
            camera.getWorldDirection(direction);
            position.addScaledVector(direction, distance);

            if (itemData.type === 'board' || itemData.type === 'text') {
                pendingTextPosition = position;
                openTextModal(itemData.type === 'board' ? 'اكتب محتوى السبورة...' : 'اكتب النص هنا...');
            } else {
                create3DModelItem(currentSelectedItem, position, itemData.color, 'عنصر قياسي');
                saveWorld();
            }
        }

        function create3DModelItem(type, position, color, textContent) {
            let geometry, material, mesh;

            if (type === 'board' || type === 'text') {
                // إنشاء سبورة أو نص كلوحة تظهر الكلام
                const canvas = document.createElement('canvas');
                canvas.width = 512;
                canvas.height = 256;
                const context = canvas.getContext('2d');
                context.fillStyle = type === 'board' ? '#1b3a1b' : '#222222';
                context.fillRect(0, 0, canvas.width, canvas.height);
                context.fillStyle = '#ffffff';
                context.font = '36px sans-serif';
                context.textAlign = 'center';
                context.textBaseline = 'middle';
                context.fillText(textContent || 'ملاحظة', canvas.width / 2, canvas.height / 2);

                const texture = new THREE.CanvasTexture(canvas);
                geometry = new THREE.BoxGeometry(2, 1.2, 0.1);
                material = new THREE.MeshStandardMaterial({ map: texture });
            } else {
                geometry = new THREE.BoxGeometry(0.8, 0.8, 0.8);
                material = new THREE.MeshStandardMaterial({ color: color, roughness: 0.3 });
            }

            mesh = new THREE.Mesh(geometry, material);
            mesh.position.copy(position);
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            
            // تخزين نوع البيانات للحفظ لاحقاً
            mesh.userData = { type: type, itemKey: type, text: textContent };
            
            scene.add(mesh);
            objectsInWorld.push(mesh);
        }

        function openTextModal(placeholder) {
            isTextModalOpen = true;
            controls.unlock();
            const modal = document.getElementById('text-modal');
            const input = document.getElementById('text-input');
            input.value = '';
            input.placeholder = placeholder;
            modal.style.display = 'block';
            input.focus();
        }

        function closeTextModal() {
            isTextModalOpen = false;
            document.getElementById('text-modal').style.display = 'none';
        }

        document.getElementById('save-text-btn').onclick = () => {
            const text = document.getElementById('text-input').value;
            if (pendingTextPosition && text) {
                create3DModelItem(currentSelectedItem, pendingTextPosition, 0xffffff, text);
                saveWorld();
            }
            closeTextModal();
        };

        function rotateSelectedObject() {
            // تدوير أقرب عنصر أمام اللاعب
            if (objectsInWorld.length > 0) {
                const obj = objectsInWorld[objectsInWorld.length - 1];
                obj.rotation.y += Math.PI / 4;
                saveWorld();
            }
        }

        function removeAimedObject() {
            if (objectsInWorld.length > 0) {
                const obj = objectsInWorld.pop();
                scene.remove(obj);
                saveWorld();
            }
        }

        function saveWorld() {
            const data = objectsInWorld.map(obj => ({
                type: obj.userData.type,
                itemKey: obj.userData.itemKey,
                text: obj.userData.text,
                position: { x: obj.position.x, y: obj.position.y, z: obj.position.z },
                rotation: { y: obj.rotation.y }
            }));
            localStorage.setItem('study_world_data', JSON.stringify(data));
        }

        function loadWorld() {
            const saved = localStorage.getItem('study_world_data');
            if (!saved) return;
            try {
                const data = JSON.parse(saved);
                data.forEach(item => {
                    const itemDef = availableItems[item.itemKey];
                    const color = itemDef ? itemDef.color : 0xffffff;
                    create3DModelItem(item.itemKey, new THREE.Vector3(item.position.x, item.position.y, item.position.z), color, item.text);
                    if (objectsInWorld.length > 0) {
                        objectsInWorld[objectsInWorld.length - 1].rotation.y = item.rotation.y;
                    }
                });
            } catch (e) {
                console.error("خطأ في استرجاع العالم المحفوظ", e);
            }
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);

            const time = performance.now();
            if (controls.isLocked) {
                const delta = (time - prevTime) / 1000;

                velocity.x -= velocity.x * 10.0 * delta;
                velocity.z -= velocity.z * 10.0 * delta;

                direction.z = Number(moveForward) - Number(moveBackward);
                direction.x = Number(moveRight) - Number(moveLeft);
                direction.normalize();

                if (moveForward || moveBackward) velocity.z -= direction.z * 40.0 * delta;
                if (moveLeft || moveRight) velocity.x -= direction.x * 40.0 * delta;

                controls.moveRight(-velocity.x * delta);
                controls.moveForward(-velocity.z * delta);
            }

            prevTime = time;
            renderer.render(scene, camera);
        }
    </script>
</body>
</html>
